// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CRM ───────────────────────────────────────────────────────────────────

model Prospect {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Infos de base
  name        String
  company     String?
  email       String  @unique
  phone       String?
  linkedinUrl String?
  websiteUrl  String?

  // Pipeline
  status ProspectStatus @default(NEW)
  score  Int? // 1-10 par Claude (1 = faible, 10 = excellent)

  // Contexte
  needType        String[] // ["webapp", "site", "consulting", "api"]
  estimatedBudget Float?
  source          String? // linkedin, referral, github, site

  // Suivi
  lastContactedAt DateTime?
  nextActionAt    DateTime?
  nextActionNote  String?

  // Contexte entreprise
  companyDescription String? @db.Text // notes libres sur l'entreprise

  // IA
  aiSummary           String? // résumé Claude du prospect
  aiScoreReason       String? // pourquoi ce score
  aiTags              String[] // tags générés par le scoring
  aiRecommendedAction String? // action recommandée par le scoring

  // Relations
  emails    Email[]
  notes     Note[]
  reminders Reminder[]

  @@index([status])
  @@index([updatedAt])
}

enum ProspectStatus {
  NEW
  SCORING
  SCORED
  VIP
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

model Email {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  direction EmailDirection
  subject   String
  body      String         @db.Text
  sentAt    DateTime
  gmailId   String? // ID Gmail pour le threading

  // Analyse IA
  aiAnalysis String? // résumé Claude de l'email reçu
  aiIntent   String? // INTERESTED / NOT_INTERESTED / NEEDS_INFO / CALLBACK

  @@index([prospectId])
  @@index([prospectId, direction])
  @@index([sentAt])
}

enum EmailDirection {
  SENT
  RECEIVED
}

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  content String  @db.Text
  source  String? // manual, granola, ai
}

model Reminder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  dueAt  DateTime
  note   String
  status ReminderStatus @default(PENDING)
  type   ReminderType

  @@index([prospectId])
  @@index([status, dueAt])
}

enum ReminderStatus {
  PENDING
  DONE
  SNOOZED
}

enum ReminderType {
  FOLLOW_UP
  CALL
  PROPOSAL
  CUSTOM
}
