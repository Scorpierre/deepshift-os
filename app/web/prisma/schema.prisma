// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── CRM ───────────────────────────────────────────────────────────────────

model Prospect {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Infos de base
  name        String
  company     String?
  email       String  @unique
  phone       String?
  linkedinUrl String?
  websiteUrl  String?

  // Pipeline
  status ProspectStatus @default(NEW)
  score  Int? // 1-10 par Claude (1 = faible, 10 = excellent)

  // Contexte
  needType        String[] // ["webapp", "site", "consulting", "api"]
  estimatedBudget Float?
  source          String? // linkedin, referral, github, site

  // Suivi
  lastContactedAt DateTime?
  nextActionAt    DateTime?
  nextActionNote  String?

  // Contexte entreprise
  companyDescription String? @db.Text // notes libres sur l'entreprise
  prospectNotes      String? @db.Text // brief complémentaire saisi manuellement (passé à l'IA)

  // IA
  aiSummary           String? // résumé Claude du prospect
  aiScoreReason       String? // pourquoi ce score
  aiTags              String[] // tags générés par le scoring
  aiRecommendedAction String? // action recommandée par le scoring

  // Relations
  emails    Email[]
  notes     Note[]
  reminders Reminder[]
  quotes    Quote[]
  invoices  Invoice[]
  projects  Project[]

  @@index([status])
  @@index([updatedAt])
}

enum ProspectStatus {
  NEW
  SCORING
  SCORED
  VIP
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

model Email {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  direction EmailDirection
  subject   String
  body      String         @db.Text
  sentAt    DateTime
  gmailId   String? // ID Gmail pour le threading

  // Analyse IA
  aiAnalysis String? // résumé Claude de l'email reçu
  aiIntent   String? // INTERESTED / NOT_INTERESTED / NEEDS_INFO / CALLBACK

  @@index([prospectId])
  @@index([prospectId, direction])
  @@index([sentAt])
}

enum EmailDirection {
  SENT
  RECEIVED
}

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  content String  @db.Text
  source  String? // manual, granola, ai
}

model Reminder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  dueAt  DateTime
  note   String
  status ReminderStatus @default(PENDING)
  type   ReminderType

  @@index([prospectId])
  @@index([status, dueAt])
}

enum ReminderStatus {
  PENDING
  DONE
  SNOOZED
}

enum ReminderType {
  FOLLOW_UP
  CALL
  PROPOSAL
  CUSTOM
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Quote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  number     String      @unique // DEVIS-2026-001
  title      String
  lines      Json        // [{description, qty, unitPrice, total}]
  totalHT    Float
  validUntil DateTime?
  sentAt     DateTime?
  notes      String?     @db.Text
  status     QuoteStatus @default(DRAFT)

  invoice Invoice?

  @@index([prospectId])
  @@index([status])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  number   String        @unique // FAC-2026-001
  title    String
  lines    Json
  totalHT  Float
  issuedAt DateTime      @default(now())
  dueAt    DateTime
  paidAt   DateTime?
  notes    String?       @db.Text
  status   InvoiceStatus @default(PENDING)

  paymentReminders PaymentReminder[]

  @@index([prospectId])
  @@index([status])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model PaymentReminder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sentAt DateTime
  type   PaymentReminderType
}

enum PaymentReminderType {
  DAY_30
  DAY_45
}

// ─── Projets ──────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  prospectId  String
  prospect    Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  name        String
  description String?       @db.Text
  status      ProjectStatus @default(BRIEF)
  startDate   DateTime?
  deadline    DateTime?
  budget      Float?

  milestones  Milestone[]
  deliveries  Delivery[]
  clientNotes ClientNote[]

  @@index([prospectId])
  @@index([status])
}

enum ProjectStatus {
  BRIEF
  IN_PROGRESS
  REVIEW
  DELIVERED
  COMPLETED
  ON_HOLD
}

model Milestone {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())

  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  dueAt       DateTime?
  status      MilestoneStatus @default(PENDING)
  order       Int             @default(0)

  tasks       Task[]

  @@index([projectId])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Task {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  title       String
  done        Boolean   @default(false)
  order       Int       @default(0)

  @@index([milestoneId])
}

model Delivery {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?   @db.Text
  deliveredAt DateTime  @default(now())
  clientOk    Boolean?
  feedback    String?   @db.Text

  @@index([projectId])
}

model ClientNote {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())

  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  content   String         @db.Text
  type      ClientNoteType @default(OTHER)

  @@index([projectId])
}

enum ClientNoteType {
  MEETING
  FEEDBACK
  DECISION
  OTHER
}
